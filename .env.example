# =============================================================================
# EduPath Production & Environment Configuration Template
# IMPORTANT: Never commit production credentials, passwords or secret keys.
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000

# PostgreSQL Database Configuration
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=prefer
# Set a strong, randomly generated password in production. Do NOT use default 'postgres/postgres'.
DATABASE_URL=postgres://edupath_admin:REPLACE_WITH_STRONG_RANDOM_PASSWORD@localhost:5432/edupath

# Authentication & Session Security (Required)
# Generate a strong 64-character secret using: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_KEY
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_KEY

# Administrative Operations
# Set to 'false' in production. Must be explicitly 'true' to allow destructive re-seeding.
ALLOW_DESTRUCTIVE_SEEDER=false

# Ops & Privacy Configuration
COPPA_CONSENT_ENFORCED=true
STUDENT_DATA_PRIVACY_STRICT=true
